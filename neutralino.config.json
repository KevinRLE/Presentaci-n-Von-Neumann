{
  "applicationId": "js.neutralino.electrocover",
  "version": "1.0.0",
  "defaultMode": "window",
  "documentRoot": "/resources/",
  "url": "/index.html",
  "enableServer": true,
  "enableNativeAPI": true,
  "cli": {
    "binaryVersion": "5.8.0",
    "resourcesPath": "/resources/",
    "clientLibrary": "/resources/js/neutralino.js",
    "binaryName": "PresentacionVonNeumann",
    "clientVersion": "6.4.0"
    },
  "nativeAllowList": [
    "app.*",
    "window.*",
    "os.*"
  ],
    "modes": {
    "window": {
        "title": "Presentación Arquitectura Von Neumann",
        "width": 1200,
        "height": 800,
        "icon": "/resources/assets/electrocover.ico",
        "enableInspector": false,
        "exitProcessOnClose": true,
        "consoleMode": "none"
    }
}
}